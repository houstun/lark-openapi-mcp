# Feishu/Lark app credentials
APP_ID=cli_xxxx
APP_SECRET=your_secret

# API endpoint
LARK_DOMAIN=https://open.feishu.cn

# Tool preset or comma-separated tool list
LARK_TOOLS=preset.doc.default

# auto | user_access_token | tenant_access_token
LARK_TOKEN_MODE=auto

# Optional defaults
# LARK_LANGUAGE=zh
# LARK_TOOL_NAME_CASE=dot
